# npm config. Yarn 4 is the installer and ignores this file -- see .yarnrc.yml.
# This only covers `npx`, `npm outdated`, `npm audit`, and stray `npm install`.

# Quarantine releases younger than 7 days; compromised ones are usually yanked
# within hours. Unit is days. Mirrors `npmMinimalAgeGate: 7d` in .yarnrc.yml.
min-release-age=7

# Stop an accidental `npm install` writing a package-lock.json beside yarn.lock.
package-lock=false

# package.json declares engines.node >= 22.18.0 -- fail instead of warn.
engine-strict=true

# Drop the funding footer from npm output.
fund=false

# `npm audit` reports high and critical only.
audit-level=high
